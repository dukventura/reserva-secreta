# Copie para .env local (nunca commitado) e, em produção, configure
# estas mesmas chaves na aba "Environment variables" do Setup Node.js
# App no cPanel — não em arquivo .env no servidor.

# Dados da conta criada em MySQL Databases no cPanel.
# O prefixo do nome do banco/usuário normalmente é o do login cPanel,
# ex: usuario_reservasecreta
DB_HOST=localhost
DB_PORT=3306
DB_NAME=usuario_reservasecreta
DB_USER=usuario_rsapi
DB_PASSWORD=

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta local de desenvolvimento. Em produção o Passenger injeta PORT
# automaticamente — o código nunca deve fixar essa porta.
PORT=3001

# Origem do front-end, para a checagem de CORS.
CORS_ORIGIN=https://reservasecreta.com.br

# URL publica desta API, usada para montar o link das fotos enviadas
# (ex: https://api.reservasecreta.com.br/uploads/<arquivo>). Sem isso
# definido, cai no fallback http://localhost:PORT.
PUBLIC_URL=https://api.reservasecreta.com.br

# Endereco publico do front-end, usado nos links do sitemap de perfis
# (GET /sitemap-perfis.xml).
SITE_URL=https://reservasecreta.com.br

# Mercado Pago (pagamento automatico de plano via PIX, alternativa ao
# PIX manual). Access Token em Mercado Pago > Seu negocio >
# Configuracoes > Credenciais (use o de teste pra testar sem dinheiro
# de verdade). Sem isso definido, a opcao de pagamento automatico fica
# desabilitada e so o PIX manual aparece.
MERCADOPAGO_ACCESS_TOKEN=

# Webhook secret, gerado quando voce cria/edita o endpoint de webhook
# no painel do Mercado Pago (aba Webhooks da aplicacao) - usado pra
# validar que a notificacao realmente veio deles.
MERCADOPAGO_WEBHOOK_SECRET=
